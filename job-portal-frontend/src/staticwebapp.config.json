{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/*.js", "/*.css", "/*.png", "/*.jpg", "/*.svg", "/*.ico", "/*.json"]
  },
  "routes": [
    {
      "route": "/*",
      "headers": {
        "cache-control": "no-cache, no-store, must-revalidate",
        "pragma": "no-cache"
      }
    }
  ],
  "globalHeaders": {
    "cache-control": "no-cache, no-store, must-revalidate"
  }
}
