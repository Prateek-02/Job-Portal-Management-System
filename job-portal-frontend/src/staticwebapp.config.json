{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/favicon.ico", "/*.js", "/*.css"]
  },
  "routes": [
    {
      "route": "/*",
      "headers": {
        "cache-control": "must-revalidate, max-age=604800"
      }
    }
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/index.html",
      "statusCode": 200
    }
  }
}
